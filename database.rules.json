{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('meta/owner').val() === auth.uid || data.child('meta/created').val() < now - 43200000)",
        ".validate": "$code.matches(/^[0-9]{4}$/) && newData.hasChild('meta')",
        "meta": {
          ".validate": "newData.hasChildren(['owner', 'state', 'created', 'seconds', 'startedAt', 'endsAt']) && newData.child('owner').val() === auth.uid",
          "owner": {
            ".validate": "newData.isString()"
          },
          "state": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'ended'"
          },
          "created": {
            ".validate": "newData.isNumber()"
          },
          "seconds": {
            ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 600"
          },
          "startedAt": {
            ".validate": "newData.isNumber()"
          },
          "endsAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.exists() && root.child('rooms/' + $code + '/meta').exists() && ((root.child('rooms/' + $code + '/meta/state').val() === 'lobby' && newData.child('score').val() === 0) || (root.child('rooms/' + $code + '/meta/state').val() !== 'lobby' && now <= root.child('rooms/' + $code + '/meta/endsAt').val() + 5000))",
            ".validate": "newData.hasChildren(['name', 'score', 'found', 'wrong'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "found": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60"
            },
            "wrong": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "chips": {
              "$i": {
                ".validate": "$i.matches(/^[0-5]$/)",
                "seen": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600000"
                },
                "hits": {
                  "$h": {
                    ".validate": "$h.matches(/^[0-9]$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
                  }
                },
                "taps": {
                  "$k": {
                    ".validate": "$k.matches(/^[0-9]{1,3}$/)",
                    "$j": {
                      ".validate": "$j.matches(/^[0-2]$/) && newData.isNumber()"
                    }
                  }
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "cases": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('meta/owner').val() === auth.uid || data.child('meta/created').val() < now - 43200000)",
        ".validate": "$code.matches(/^[0-9]{4}$/) && newData.hasChild('meta')",
        "meta": {
          ".validate": "newData.hasChildren(['owner', 'state', 'created', 'startedAt']) && newData.child('owner').val() === auth.uid",
          "owner": {
            ".validate": "newData.isString()"
          },
          "state": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'open' || newData.val() === 'closed'"
          },
          "created": {
            ".validate": "newData.isNumber()"
          },
          "startedAt": {
            ".validate": "newData.isNumber()"
          },
          "closedAt": {
            ".validate": "newData.isNumber()"
          },
          "evidence": {
            "$k": {
              ".validate": "$k.matches(/^[a-zA-Z0-9]{1,16}$/) && (newData.isNumber() || (newData.isString() && newData.val().length <= 40))"
            }
          },
          "round": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "groups": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.exists() && root.child('cases/' + $code + '/meta').exists() && root.child('cases/' + $code + '/meta').child('state').val() !== 'closed'",
            ".validate": "newData.hasChildren(['name', 'stage'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10"
            },
            "stage": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "times": {
              "$k": {
                ".validate": "$k.matches(/^s[0-5]$/) && newData.isNumber() && newData.val() >= 0"
              }
            },
            "hints": {
              "$k": {
                ".validate": "$k.matches(/^s[0-5]$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
              }
            },
            "ans": {
              "$k": {
                ".validate": "$k.matches(/^[a-zA-Z0-9]{1,12}$/) && (newData.isNumber() || (newData.isString() && newData.val().length <= 300))"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}